# Copie este arquivo para .env e preencha. O .env NUNCA deve ir para o GitHub.

# Chave da API da OpenAI, usada pelo coach de IA (opcional: sem ela o resto do app funciona)
OPENAI_API_KEY=coloque_sua_chave_aqui

# Modelo usado pelo coach
LLM_MODEL=gpt-4o-mini

# Endereço da API (troque para usar um modelo local, como o Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1
